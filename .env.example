# Copy to .env and fill in. NEVER commit .env.
# (Comments must be on their own lines so Docker --env-file parses this file correctly.)

# development | test | production
APP_ENV=development

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public key. The browser uses it for sign-in only.
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security. Never expose it to the browser or commit it.
SUPABASE_SERVICE_KEY=
# Only needed if your project still signs tokens with the legacy HS256 JWT secret.
# Projects with asymmetric signing keys are verified through the JWKS endpoint automatically.
SUPABASE_JWT_SECRET=

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# --- Voyage AI embeddings ---
VOYAGE_API_KEY=
EMBED_MODEL=voyage-4
# 256 | 512 | 1024. Must match vector(N) in supabase/migrations.
EMBED_DIM=1024

# --- Limits and cost controls ---
DAILY_QUESTION_LIMIT=50
MAX_UPLOAD_MB=25
MAX_DOCUMENT_PAGES=500
MAX_QUESTION_LENGTH=2000
MAX_CONTEXT_TOKENS=6000
MAX_OUTPUT_TOKENS=1200

# --- Web ---
# Comma separated explicit origins (https only in production).
ALLOWED_ORIGINS=http://localhost:8000
# Number of reverse proxies in front of the app (used to find the real client IP).
TRUSTED_PROXY_COUNT=0
LOG_LEVEL=INFO
PORT=8000
